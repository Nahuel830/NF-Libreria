# Ejemplo de configuración para producción (VPS con dominio y HTTPS) — WEB-1 1.1
# Copiar como `.env.production` en el SERVIDOR (nunca se sube a git) y completar.
# Sin secretos: APP_KEY se genera en el servidor y las contraseñas no van aquí.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://DOMINIO
APP_TIMEZONE=America/La_Paz

# APP_KEY: generarla SOLO en el servidor con `php artisan key:generate --show`
# y respaldarla fuera del VPS (sin ella se pierden sesiones cifradas y TOTP).

LOG_CHANNEL=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_ENCRYPT=true

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=libreria
DB_USERNAME=libreria
# DB_PASSWORD: definirla solo en el `.env.production` real del servidor.

CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Proxies de confianza (ver 1.2): vacío si Nginx está directo; rangos de
# Cloudflare (https://www.cloudflare.com/ips/) solo si se usa Cloudflare con proxy.
TRUSTED_PROXIES=
